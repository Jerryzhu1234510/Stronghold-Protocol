clients/**/tools/
clients/**/build/
clients/**/export/
clients/**/test-output/

# Local acceptance, account state, exports and bundled runtimes never belong in source control.
.tmp*/
test-output/
local-state/
private/
private-local/
state/
backups/
runtime/
MANIFEST.json
